{
  "name": "apollo-study",
  "productName": "Apollo Study",
  "version": "0.1.0",
  "private": true,
  "description": "Apollo, the offline, private AI study app",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n ui,app \"vite --port 5173 --strictPort\" \"wait-on tcp:5173 && electron . --dev\"",
    "ui": "vite --port 5173 --strictPort",
    "build": "tsc --noEmit && vite build",
    "start": "vite build && electron .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "dompurify": "^3.2.3",
    "katex": "^0.16.11",
    "marked": "^14.1.4",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/katex": "^0.16.7",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "electron": "^33.2.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "wait-on": "^8.0.1"
  }
}
