{
  "name": "apollo-study",
  "productName": "Apollo Study",
  "version": "1.2.1",
  "private": true,
  "description": "Apollo Study: private AI study app (local models by default)",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n ui,app \"vite --port 5173 --strictPort\" \"wait-on tcp:5173 && electron . --dev\"",
    "ui": "vite --port 5173 --strictPort",
    "build": "tsc --noEmit && vite build",
    "start": "vite build && electron .",
    "typecheck": "tsc --noEmit",
    "build:backend": "cd ../backend && uv run pyinstaller studyapp-backend.spec --noconfirm",
    "dist": "npm run build && npm run build:backend && electron-builder --win portable",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "node scripts/check.mjs",
    "test:electron": "vite build && node tests/electron/smoke.mjs"
  },
  "dependencies": {
    "dompurify": "^3.2.3",
    "katex": "^0.16.11",
    "lucide-react": "1.59.0",
    "marked": "^14.1.4",
    "pdfjs-dist": "6.4.299",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/katex": "^0.16.7",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "electron": "45.2.3",
    "electron-builder": "^25.1.8",
    "jsdom": "26.1.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "3.2.4",
    "wait-on": "^8.0.1"
  },
  "author": "Apollo Study",
  "build": {
    "appId": "com.apollo.study",
    "productName": "Apollo Study",
    "copyright": "Apollo Study",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "dist/**",
      "electron/**",
      "assets/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../backend/dist/studyapp-backend",
        "to": "backend"
      }
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "portable": {
      "artifactName": "ApolloStudy-${version}-portable.exe"
    },
    "asar": true
  }
}
