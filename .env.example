# Copy to .env and fill in. All values can also be set in the app under Settings.

EMBED_BASE_URL=
EMBED_API_KEY=
EMBED_MODEL=

LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_CONTEXT=
LLM_CONCURRENCY=1
LLM_VISION=true

# Optional online models via OpenRouter (off until selected in Settings; data is sent to external servers)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free
OPENROUTER_EMBED_MODEL=nvidia/nemotron-3.5-embed-1b:free
